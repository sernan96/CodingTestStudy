# ========================================
# 프론트엔드 환경설정 예제
# ========================================
# 이 파일을 .env로 복사하고 값을 수정하세요

# ========================================
# API 설정
# ========================================
REACT_APP_API_BASE_URL=http://localhost:5000
REACT_APP_API_TIMEOUT=10000

# ========================================
# 인증 설정
# ========================================
REACT_APP_TOKEN_KEY=auth_token
REACT_APP_AUTH_HEADER=Authorization
REACT_APP_TOKEN_PREFIX=Bearer

# ========================================
# API 엔드포인트
# ========================================
# Auth API
REACT_APP_AUTH_LOGIN=/api/auth/login
REACT_APP_AUTH_SIGNUP=/api/auth/signup

# Study API
REACT_APP_STUDY_LIST=/api/study/list
REACT_APP_STUDY_DETAIL=/api/study
REACT_APP_STUDY_CREATE=/api/study
REACT_APP_STUDY_JOIN=/api/study/join
REACT_APP_STUDY_WITHDRAW=/api/study

# Problem API
REACT_APP_PROBLEM_REGISTER=/api/problem
REACT_APP_PROBLEM_VACATION_USE=/api/problem/vacation/use

# ========================================
# UI 설정
# ========================================
REACT_APP_VACATION_EARLY_MORNING_START=0
REACT_APP_VACATION_EARLY_MORNING_END=6
REACT_APP_MAX_STUDY_MEMBERS=6
REACT_APP_DEFAULT_VACATION_DAYS=10

# ========================================
# 기타 설정
# ========================================
REACT_APP_ENV=development
REACT_APP_VERSION=1.0.0
